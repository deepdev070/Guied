{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3000",
      "startServerReadyPattern": "ready on|started server on|http://localhost:3000",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/driving-licence-learner",
        "http://localhost:3000/state/gujarat"
      ],
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 740,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "optimistic"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "optimistic"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "optimistic"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "optimistic"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

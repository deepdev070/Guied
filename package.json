{
  "name": "india-paperwork-guide-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "next start",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts && vitest run",
    "test:vitest": "vitest run",
    "test:turbo": "turbo run test",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run content:validate && npm run content:gate",
    "content:stale": "node --no-warnings --experimental-strip-types scripts/check-stale-content.ts",
    "content:validate": "node --no-warnings --experimental-strip-types scripts/validate-content.ts",
    "content:gate": "node --no-warnings --experimental-strip-types scripts/check-thin-content.ts",
    "content:plain-language": "node --no-warnings --experimental-strip-types scripts/check-plain-language.ts",
    "i18n:export": "node --no-warnings --experimental-strip-types scripts/export-translations.ts",
    "i18n:import": "node --no-warnings --experimental-strip-types scripts/import-translations.ts",
    "seo:orphans": "node --no-warnings --experimental-strip-types scripts/detect-orphan-pages.ts",
    "seo:audit": "node --no-warnings --experimental-strip-types scripts/seo-audit.ts",
    "pwa:icons": "node --no-warnings --experimental-strip-types scripts/generate-pwa-icons.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "backup:db": "node --no-warnings --experimental-strip-types scripts/backup-db.ts",
    "backup:content": "node --no-warnings --experimental-strip-types scripts/backup-content-json.ts",
    "restore:test": "node --no-warnings --experimental-strip-types scripts/restore-db.ts",
    "weekly": "node --no-warnings --experimental-strip-types scripts/weekly-routine.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && turbo run build"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@civic/types": "*",
    "@civic/utils": "*",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "turbo": "^2.11.11",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@types/node": "^22.0.0"
  }
}

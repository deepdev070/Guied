b:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","$L15",null,{"task":{"slug":"driving-licence-learner","name":"Learner's Licence Application","description":"How to apply for a learner driving licence (LLR) online or at an RTO in India.","categorySlug":"vehicles","national":{"title":"How to Get a Learner's Licence in India (2026)","summary":"Complete document checklist, ₹200 official statutory fee breakdown, and step-by-step application instructions for Learner Licence across all Indian states.","estimatedTime":"15-30 days","difficulty":"easy","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","verifiedBy":"Civic Research Editorial Team","sourceUrl":"https://parivahan.gov.in/parivahan//en/content/learner-licence","steps":[{"stepNumber":1,"title":"Submit Form 2 on the Sarathi Parivahan Portal","description":"Go to parivahan.gov.in, choose your State, and select 'Apply for Learner Licence'. Fill out your applicant details, address, and select vehicle class (MCWG for geared motorcycle, LMV for car).","where":"Official Sarathi Portal (parivahan.gov.in)","estimatedTime":"15 minutes","officialLinkUrl":"https://sarathi.parivahan.gov.in","officialLinkLabel":"Open Sarathi Parivahan Application Portal","calloutType":"tip","calloutTitle":"Aadhaar e-KYC Tip","calloutText":"If your mobile number is linked to Aadhaar, choose 'Applicant with Aadhaar' for paperless online verification without an in-person RTO visit for document submission.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in"},{"stepNumber":2,"title":"Upload Required Documents & Photo","description":"Upload scanned copies of Proof of Age, Proof of Address, and Form 1 (Self-declaration of physical fitness). If not using Aadhaar e-KYC, upload your signature and passport-size photograph.","where":"Online Portal","estimatedTime":"10 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in"},{"stepNumber":3,"title":"Pay Government Fee (₹200)","description":"Pay the statutory fee of ₹150 for application processing plus ₹50 for computerized test fee via net banking, debit card, or UPI. Download and print payment receipt Form 2.","where":"Integrated Bharatkosh / State Payment Gateway","estimatedTime":"5 minutes","calloutType":"warning","calloutTitle":"Keep Payment Receipt Safe","calloutText":"Print the e-receipt immediately. The transaction reference number is required if payment status enters 'Pending'.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in"},{"stepNumber":4,"title":"Take the Computerized Learner Test (LL Test)","description":"Take the 15-question test on traffic signs and road safety. You have 30 seconds per question; score at least 11/15 (60%) to pass. On passing, your digital learner licence (Form 3) is generated instantly.","where":"Online from home (for Aadhaar e-KYC applicants) or at designated RTO Sub-Center","estimatedTime":"20 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in"},{"stepNumber":5,"title":"Download & Print Your Digital Learner Licence (Form 3)","description":"Immediately upon scoring 11 or higher on the online test, your digital Learner Licence in Form 3 is generated with a verifiable QR code. Download the PDF and keep a physical printout while practicing driving with an instructor.","where":"Sarathi Parivahan Download Section","estimatedTime":"5 minutes","calloutType":"tip","calloutTitle":"Keep QR Code Legible","calloutText":"Traffic police and licensing authorities verify learner licences by scanning the QR code directly using their handheld mParivahan terminals.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in"}],"documentRequirements":[{"name":"Proof of Age (Aadhaar / 10th Marksheet / Birth Certificate)","description":"Any officially valid document displaying your full date of birth (DD/MM/YYYY).","requirementType":"required","copiesHint":"Original + 1 self-attested photocopy","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in","displayOrder":0},{"name":"Proof of Current Residential Address","description":"Aadhaar Card, Voter ID, Electricity Bill, or registered rent agreement in applicant's name.","requirementType":"required","copiesHint":"Original + 1 photocopy","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in","displayOrder":0},{"name":"Form 1 Physical Fitness Self-Declaration","description":"Online self-declaration form confirming you have no epilepsy, night blindness, or loss of limbs.","requirementType":"required","copiesHint":"Filled online during application","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in","displayOrder":0},{"name":"Applicant Signature & Photo Digital Scan","description":"Scanned signature and passport photograph uploaded to the Parivahan Sarathi portal for electronic licence issuance.","requirementType":"required","copiesHint":"Scanned file upload (JPEG)","specs":{"dimensions":"256 × 64 pixels (4:1 signature ratio)","backgroundColor":"Plain white paper with dark blue or black ink","maxFileSizeBytes":20480,"maxFileSizeLabel":"10 KB to 20 KB","acceptedFormats":["JPEG","JPG"],"diagramType":"signature","guidanceUrl":"https://sarathi.parivahan.gov.in","instructions":["Sign with black or dark blue ballpoint pen inside a white rectangular box","Crop neatly without harsh shadows or phone flash reflections","Must be between 10 KB and 20 KB in JPEG format"]},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in","displayOrder":0},{"name":"Form 1A Medical Fitness Certificate","description":"Medical certificate signed by a registered MBBS medical practitioner with doctor's registration seal.","requirementType":"conditional","copiesHint":"Original doctor signed copy","appliesWhen":{"or":[{"applicantAge":{"gte":40}},{"licenceCategory":"commercial_transport"}]},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in","displayOrder":0}],"fees":[{"label":"Learner's Licence Application Processing Fee","amount":150,"currency":"INR","isOptional":false,"paymentMode":"online","rulesReference":"Central Motor Vehicles Rules (CMVR), Rule 32","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in"},{"label":"Computerized LL Test Fee","amount":50,"currency":"INR","isOptional":false,"paymentMode":"online","rulesReference":"Central Motor Vehicles Rules (CMVR), Rule 32","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in"}],"feeCalculator":{"title":"Learner's Licence Fee Calculator","description":"Calculate exact statutory fees based on the number of vehicle categories selected.","baseFee":200,"baseFeeLabel":"Single Vehicle Class (Form 2 ₹150 + Online Test ₹50)","options":[{"id":"vehicle_classes","label":"Vehicle Categories Applied","type":"classes","choices":[{"id":"single_class","label":"Single Class (Motorcycle or Car)","amount":0,"description":"₹150 application + ₹50 test"},{"id":"two_classes","label":"Two Classes (Motorcycle MCWG + Car LMV)","amount":150,"description":"Combined test for both two-wheeler and four-wheeler"}],"defaultChoiceId":"single_class"},{"id":"delivery","label":"Licence Issuance & Download","type":"delivery","choices":[{"id":"instant_download","label":"Direct Digital Download (e-Learner Licence)","amount":0,"description":"Instant valid digital download with QR code"},{"id":"speed_post","label":"Speed Post Hardcopy Delivery (select RTOs)","amount":50,"description":"Optional physical dispatch to residence (+₹50)"}],"defaultChoiceId":"instant_download"}],"officialSourceUrl":"https://parivahan.gov.in","officialSourceLabel":"Parivahan Sarathi Fee Schedule","rulesReference":"CMVR 1989 Rule 32"},"officialLinks":[{"label":"Sarathi Parivahan Citizen Portal","url":"https://sarathi.parivahan.gov.in","isPrimary":true,"department":"Ministry of Road Transport and Highways (MoRTH)","portalName":"Parivahan Sewa","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://parivahan.gov.in"}],"faqItems":[{"question":"How long is a Learner's Licence valid in India?","answer":"A Learner's Licence is valid for exactly 6 months (180 days) from the date of issue across all states and Union Territories.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://parivahan.gov.in"},{"question":"Can I drive alone on public roads with a Learner's Licence?","answer":"No. You must be accompanied by someone who holds a valid permanent driving licence for that vehicle. Also, your vehicle must display red 'L' plates on front and back.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in"},{"question":"What is the passing mark for the online Learner Licence test in India?","answer":"The computerized learner test consists of 15 multiple-choice questions covering Indian road signs, traffic signals, and fundamental driving regulations. You must answer at least 11 questions correctly (60% score) within the allotted 30 seconds per question to pass.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in"},{"question":"When can I apply for a permanent driving licence after getting my learner licence?","answer":"You can apply for a permanent driving licence after 30 days from your Learner Licence issue date. You must apply within 180 days (6 months) before the learner licence expires.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://morth.nic.in"}],"rejectionReasons":[{"title":"Name or Date of Birth Mismatch on Aadhaar","description":"If the name on your 10th marksheet or birth certificate does not match the name returned by Aadhaar e-KYC, the application is halted.","solution":"Update your Aadhaar details first at an Aadhaar Seva Kendra, or apply via non-Aadhaar mode with physical document scrutiny at the RTO.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://sarathi.parivahan.gov.in"}],"sourceRefs":[{"title":"The Motor Vehicles (Amendment) Act, 2019","actOrRuleNumber":"Section 8 and 9","issuingAuthority":"Parliament of India / MoRTH","url":"https://morth.nic.in","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z"}]},"states":{"GJ":{"title":"How to Apply for Learner's Licence in Gujarat (2026)","summary":"Gujarat offers 100% contactless online Learner Licence services with home-based computerized testing through Sarathi Parivahan and Digital Gujarat.","estimatedTime":"7-15 days","lastVerifiedAt":"2026-11-14T00:00:00.000Z"}}},"variant":{"title":"How to Get a Learner's Licence in India (2026)","summary":"Complete document checklist, ₹200 official statutory fee breakdown, and step-by-step application instructions for Learner Licence across all Indian states.","estimatedTime":"15-30 days","difficulty":"easy","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","verifiedBy":"Civic Research Editorial Team","sourceUrl":"https://parivahan.gov.in/parivahan//en/content/learner-licence","steps":[{"stepNumber":1,"title":"Submit Form 2 on the Sarathi Parivahan Portal","description":"Go to parivahan.gov.in, choose your State, and select 'Apply for Learner Licence'. Fill out your applicant details, address, and select vehicle class (MCWG for geared motorcycle, LMV for car).","where":"Official Sarathi Portal (parivahan.gov.in)","estimatedTime":"15 minutes","officialLinkUrl":"https://sarathi.parivahan.gov.in","officia
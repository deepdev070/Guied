b:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","$L15",null,{"task":{"slug":"passport-renewal","name":"Passport Renewal (Re-issue)","description":"Complete guide to renewing or re-issuing an Indian passport online with verified fees, document checklist, and PSK appointment steps.","categorySlug":"identity","national":{"title":"How to Renew Your Indian Passport: Documents, Fees, and Steps (2026)","summary":"Step-by-step procedure to re-issue an expired or expiring Indian passport online through the official Passport Seva portal. Verified fees (₹1,500 normal, ₹3,500 tatkaal) and document rules.","estimatedTime":"7-14 working days (Normal) / 1-3 days (Tatkaal)","difficulty":"medium","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","verifiedBy":"Civic Research Editorial Team","sourceUrl":"https://www.passportindia.gov.in/AppOnlineProject/online/faqServicesAvailable","steps":[{"stepNumber":1,"title":"Register or Log In to Official Passport Seva Portal","description":"Visit passportindia.gov.in and select your Passport Office based on your current city. Register a new account or log in with existing credentials.","where":"Official Passport Seva Portal (passportindia.gov.in)","estimatedTime":"5 minutes","officialLinkUrl":"https://www.passportindia.gov.in","officialLinkLabel":"Open Official Passport Seva Portal","calloutType":"warning","calloutTitle":"Official Domain Warning","calloutText":"Only apply on passportindia.gov.in. Never use unauthorized commercial websites that mimic the portal and charge illegitimate consulting fees.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":2,"title":"Select 'Apply for Fresh Passport / Re-issue of Passport'","description":"Click 'Apply for Fresh Passport / Re-issue of Passport'. Select 'Re-issue', choose your reason, and pick booklet size (36 or 60 pages) and scheme.","where":"Online Application Dashboard","estimatedTime":"5 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":3,"title":"Fill the Online Application Form Details","description":"Enter your applicant details, family details (father, mother, spouse), current residential address, emergency contact, and existing passport number, issue date, and expiry date. Provide details of two local references residing in your neighbourhood.","where":"Online Form (Form 1)","estimatedTime":"20 minutes","calloutType":"tip","calloutTitle":"Non-ECR Category Eligibility","calloutText":"If you passed 10th standard or hold a degree, select Non-ECR. This avoids emigration check restrictions when travelling overseas.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":4,"title":"Pay Government Statutory Fee Online","description":"Click 'Pay and Schedule Appointment'. Pay ₹1,500 (36 pages) or ₹2,000 (60 pages) online via Net Banking, Card, or UPI. Payment is mandatory to book a slot.","where":"Integrated SBI ePay Gateway","estimatedTime":"5 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":5,"title":"Schedule Appointment at Nearest PSK or POPSK","description":"Select your nearest Passport Seva Kendra (PSK) or Post Office Passport Seva Kendra (POPSK) and choose an available date and time slot. Print or download the Application Receipt showing your ARN and appointment batch time.","where":"Online Slot Booking System","estimatedTime":"5 minutes","calloutType":"important","calloutTitle":"SMS on Mobile Is Valid","calloutText":"Carrying an SMS appointment confirmation on your mobile phone with ARN is officially accepted at the PSK entrance gate in lieu of a paper printout.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":6,"title":"Visit the PSK with Original Documents","description":"Arrive 15 minutes before your appointment time. You will visit Counter A for biometrics, Counter B for document verification, and Counter C for approval.","where":"Designated Passport Seva Kendra (Physical Visit)","estimatedTime":"45-90 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":7,"title":"Undergo Local Police Verification","description":"If current address has changed, local police station conducts in-person physical address verification. The police officer visits your residence to check original address proof and verify your two local references.","where":"Applicant Residence / Local Police Station","estimatedTime":"3-7 working days","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":8,"title":"Receive Renewed Passport via Speed Post","description":"Once police verification report (PVR) is cleared, your passport is printed at the India Security Press and dispatched via India Post Speed Post. You will receive an SMS with the Speed Post tracking consignment number.","where":"Delivered to Current Residential Address","estimatedTime":"2-4 working days after printing","calloutType":"success","calloutTitle":"Old Passport Retention","calloutText":"Your old passport will be physically cancelled by the PSK officer (corners clipped) and handed back to you at Counter C. Any valid unexpired visas inside remain legally valid.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"documentRequirements":[{"name":"Recent Passport-Sized Photograph (For POPSK / Minors)","description":"Required when visiting a Post Office Passport Seva Kendra (POPSK) or uploading photos for minor applicants. Must strictly follow International Civil Aviation Organization (ICAO) biometric photo standards.","requirementType":"optional","copiesHint":"2 identical physical color prints","specs":{"dimensions":"35mm × 45mm (80% face coverage)","backgroundColor":"Plain white background without shadows","maxFileSizeBytes":204800,"maxFileSizeLabel":"20 KB to 200 KB","acceptedFormats":["JPEG","JPG"],"diagramType":"photo","guidanceUrl":"https://www.passportindia.gov.in","instructions":["Face should take up 70% to 80% of the vertical frame","Frontal pose with eyes open and neutral expression (no teeth showing)","Both ears must be clearly visible without hair covering them","Spectacles with thick frames or tinted glasses are strictly disallowed"]},"appliesWhen":{"isMinor":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Original Old Passport","description":"Existing physical passport book in original condition. The passport will be cancelled and returned to the applicant.","requirementType":"required","copiesHint":"Original required for physical cancellation","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Self-Attested Photocopy of Old Passport","description":"Clear photocopies of the first two pages (bio-data), last two pages (address), ECR/Non-ECR page, and any observation page.","requirementType":"required","copiesHint":"1 self-attested set","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Proof of Current Address","description":"Required if current residential address differs from the address printed on the old passport. Accepted proofs: Aadhaar Card, Electricity Bill (not older than 3 months), Water Bill, Bank Passbook with photo, or registered rent agreement.","requirementType":"conditional","copiesHint":"Original + 1 self-attested photocopy","appliesWhen":{"addressChanged":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Proof of Non-ECR Category (10th Marksheet or Degree Certificate)","description":"Educational certificate showing completion of 10th standard (Matriculation) or higher qualification to claim Emigration Check Not Required status.","requirementType":"conditional","copiesHint":"Original + 1 self-attested photocopy","appliesWhen":{"nonEcrEligible":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Marriage Certificate / Spouse Proof","description":"Required only if adding spouse name for the first time or requesting surname change after marriage.","requirementType":"conditional","copiesHint":"Original + 1 self-attested photocopy","appliesWhen":{"addSpouse":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Annexure E / Tatkaal Verification Proof","description":"Standard self-declaration in format Annexure E required specifically for expedited Tatkaal passport processing.","requirementType":"conditional","copiesHint":"Original signed printout","appliesWhen":{"scheme":"tatkaal"},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0}],"fees":[{"label":"Normal Re-issue Fee (36 Pages Booklet, 10-Year Validity)","amount":1500,"currency":"INR","isOptional":false,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Jumbo Re-issue Fee (60 Pages Booklet, 10-Year Validity)","amount":2000,"currency":"INR","isOptional":false,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Tatkaal Scheme Additional Surcharge (Expedited 1-3 Day Processing)","amount":2000,"currency":"INR","isOptional":true,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Minor Passport Re-issue Fee (Below 18 Years, 5-Year Validity)","amount":1000,"currency":"INR","isOptional":true,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"feeCalculator":{"title":"Passport Re-issue Fee Calculator","description":"Select application urgency (Normal vs Tatkaal), booklet pages (36 vs 60), and applicant age to see your live statutory total.","baseFee":1500,"baseFeeLabel":"Base Statutory Fee (36 Pages Booklet, Adult)","options":[{"id":"scheme","label":"Processing Scheme","type":"scheme","choices":[{"id":"normal","label":"Normal Scheme (10–15 business days)","amount":0,"description":"Standard processing at Passport Seva Kendra"},{"id":"tatkal","label":"Tatkaal Scheme (Expedited 1–3 business days)","amount":2000,"description":"Urgent priority processing under Passports Act"}],"defaultChoiceId":"normal"},{"id":"pages","label":"Booklet Size","type":"pages","choices":[{"id":"pages36","label":"36 Pages (Standard Booklet)","amount":0,"description":"Recommended for standard travellers (10-year validity)"},{"id":"pages60","label":"60 Pages (Jumbo Booklet)","amount":500,"description":"Frequent flyer booklet (+₹500 gazette fee)"}],"defaultChoiceId":"pages36"},{"id":"applicant","label":"Applicant Category","type":"applicant","choices":[{"id":"adult","label":"Adult (18 years and above)","amount":0,"description":"Standard 10-year validity booklet"},{"id":"minor","label":"Minor (Below 18 years)","amount":-500,"description":"5-year validity or until age 18 (₹1,000 base fee)"}],"defaultChoiceId":"adult"},{"id":"delivery","label":"Dispatch & Notifications","type":"delivery","choices":[{"id":"standard_post","label":"Speed Post Delivery","amount":0,"description":"Included free by India Post & Ministry"},{"id":"sms_alert","label":"Speed Post + Premium SMS Tracking","amount":50,"description":"Optional 9 SMS dispatch updates (+₹50)"}],"defaultChoiceId":"standard_post"}],"officialSourceUrl":"https://passportindia.gov.in/AppOnlineProject/fee/feeSchedule","officialSourceLabel":"Ministry of External Affairs Fee Schedule","rulesReference":"Passports Rules 1980 Schedule IV"},"beforeYouGo":{"title":"Before You Leave for Passport Seva Kendra","subtitle":"5 final physical checks before heading out for your PSK slot","items":[{"id":"originals","title":"Original Old Passport & Aadhaar","description":"Carry physical original expired/expiring passport and original Aadhaar card for Biometric Counter A verification.","icon":"FolderCheck"},{"id":"photocopies","title":"2 Self-Attested Photocopy Sets","description":"First 2 and last 2 pages of passport + address proof, signed across blank margin in dark blue or black ink.","icon":"Copy"},{"id":"photos","title":"Photographs (Minors Only)","description":"Minors below 4 years require 2 physical passport photos (35x45mm white background); adults are photographed live at counter.","icon":"Camera"},{"id":"payment","title":"Fee Receipt / Active UPI","description":"Online payment receipt (already paid on portal) + carry UPI on phone in case SMS alert service or Tatkal upgrade is needed.","icon":"CreditCard"},{"id":"printout","title":"Application Receipt & Appointment SMS","description":"Printed ARN appointment receipt with bar code + appointment SMS on phone required for CISF security entry at gate.","icon":"FileText"}]},"officialLinks":[{"label":"Passport Seva Official Portal","url":"https://www.passportindia.gov.in","isPrimary":true,"department":"Consular, Passport and Visa (CPV) Division, Ministry of External Affairs","portalName":"Passport Seva Project","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Passport Fee Calculator (Official)","url":"https://www.passportindia.gov.in/AppOnlineProject/fee/feeInput","isPrimary":false,"department":"Ministry of External Affairs","portalName":"Fee Calculator","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"faqItems":[{"question":"How early before expiry can I apply for passport renewal in India?","answer":"You can apply up to 1 year before your passport expires. We recommend applying 6 to 9 months before expiry because many countries require 6 months validity.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"What happens to valid visas inside my old cancelled passport?","answer":"Your valid visas remain completely valid! The passport officer will only cancel the passport booklet itself by punching holes in the corners, leaving intact any pages containing active visas. When travelling abroad, simply carry both your new passport and the old cancelled passport containing the valid visa.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"Is police verification mandatory for every passport renewal?","answer":"Not always. If you apply within 3 years of expiry with no address change, police verification is usually waived or done post-issuance. If your address changed, pre-verification is required.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"Can I renew my passport under Tatkaal scheme?","answer":"Yes! Tatkaal renewal is available for urgent travel needs with an additional fee of ₹2,000. Tatkaal passports are dispatched within 1 to 3 working days from the date of application at the PSK. However, Tatkaal is not permitted if the passport has been expired for more than 3 years, lost, damaged, or if major name changes are requested.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"What if my passport has already expired for more than 3 years?","answer":"If your passport expired more than 3 years ago, renewal is still permitted but requires mandatory pre-issuance police verification. You will also be asked to provide an explanation letter stating the reason for late renewal.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"How do I add my spouse's name upon renewal?","answer":"In the online application form, select 'Add/Change Spouse Name' and enter your spouse's name. You must carry your Marriage Certificate or an unexpired passport of your spouse showing your name as spouse.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"Do I need to carry passport-size photos to the PSK?","answer":"For adults and children above 4 years of age, physical photos are NOT required. Your digital photograph and biometric fingerprints are captured live at Counter A inside the PSK. Only for infants and children under 4 years of age, parents must carry one recent passport-size color photograph with a plain white background.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"How can I track the delivery status of my new passport?","answer":"You can track your application online on passportindia.gov.in using your 15-digit File Number / ARN. Once dispatched, an India Post Speed Post tracking number (Consignment Number) will be sent via SMS and displayed on the status page.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"rejectionReasons":[{"title":"Address Mismatch Between Document Proof and Application","description":"Entering an address in the form that does not match your proof document will cause verification rejection. Always use an exact matching address document.","solution":"Ensure the current address typed into the form matches character-by-character with the utility bill or Aadhaar card submitted.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Unclear or Missing Pages in Old Passport Photocopy","description":"Failing to photocopy both the first two pages and the last two pages, or submitting illegible blurred copies.","solution":"Make clear, legible photocopies of pages 1, 2, 35, and 36, and self-attest each sheet with your signature.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Failed Police Verification Due to Absence from Residence","description":"When the local beat police officer visits your residence and neighbours report that you do not reside there or you cannot be contacted.","solution":"Provide active mobile numbers and ensure your two neighbourhood references are aware and available to verify your physical residence.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Applying Under Tatkaal Without Meeting Eligibility Criteria","description":"Tatkaal applications where the applicant has had major name changes, or whose previous passport was damaged or lost.","solution":"Check the official Tatkaal eligibility checklist on Passport Seva before choosing the Tatkaal scheme; otherwise apply under Normal.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Undisclosed Criminal Proceedings or Pending Court Cases","description":"Suppressing information regarding pending FIRs or criminal court summons violates Section 12 of the Passports Act 1967.","solution":"Always disclose pending matters and obtain an explicit No Objection Certificate (NOC) or court order permitting passport re-issue.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Failure to Attend Rescheduled Appointments within 1 Year","description":"Missing scheduled appointment dates without attending a PSK within the 1-year application fee validity window leads to fee forfeiture.","solution":"Reschedule your appointment online if unable to attend. You are permitted up to 3 appointment reschedules within 12 months from payment date.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"sourceRefs":[{"title":"The Passports Act, 1967","actOrRuleNumber":"Act No. 15 of 1967","issuingAuthority":"Parliament of India","url":"https://www.passportindia.gov.in","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z"},{"title":"The Passports Rules, 1980","actOrRuleNumber":"GSR 286(E) Schedule IV (Fees)","issuingAuthority":"Ministry of External Affairs, Government of India","url":"https://www.passportindia.gov.in","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z"}]},"states":{}},"variant":{"title":"How to Renew Your Indian Passport: Documents, Fees, and Steps (2026)","summary":"Step-by-step procedure to re-issue an expired or expiring Indian passport online through the official Passport Seva portal. Verified fees (₹1,500 normal, ₹3,500 tatkaal) and document rules.","estimatedTime":"7-14 working days (Normal) / 1-3 days (Tatkaal)","difficulty":"medium","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","verifiedBy":"Civic Research Editorial Team","sourceUrl":"https://www.passportindia.gov.in/AppOnlineProject/online/faqServicesAvailable","steps":[{"stepNumber":1,"title":"Register or Log In to Official Passport Seva Portal","description":"Visit passportindia.gov.in and select your Passport Office based on your current city. Register a new account or log in with existing credentials.","where":"Official Passport Seva Portal (passportindia.gov.in)","estimatedTime":"5 minutes","officialLinkUrl":"https://www.passportindia.gov.in","officialLinkLabel":"Open Official Passport Seva Portal","calloutType":"warning","calloutTitle":"Official Domain Warning","calloutText":"Only apply on passportindia.gov.in. Never use unauthorized commercial websites that mimic the portal and charge illegitimate consulting fees.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":2,"title":"Select 'Apply for Fresh Passport / Re-issue of Passport'","description":"Click 'Apply for Fresh Passport / Re-issue of Passport'. Select 'Re-issue', choose your reason, and pick booklet size (36 or 60 pages) and scheme.","where":"Online Application Dashboard","estimatedTime":"5 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":3,"title":"Fill the Online Application Form Details","description":"Enter your applicant details, family details (father, mother, spouse), current residential address, emergency contact, and existing passport number, issue date, and expiry date. Provide details of two local references residing in your neighbourhood.","where":"Online Form (Form 1)","estimatedTime":"20 minutes","calloutType":"tip","calloutTitle":"Non-ECR Category Eligibility","calloutText":"If you passed 10th standard or hold a degree, select Non-ECR. This avoids emigration check restrictions when travelling overseas.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":4,"title":"Pay Government Statutory Fee Online","description":"Click 'Pay and Schedule Appointment'. Pay ₹1,500 (36 pages) or ₹2,000 (60 pages) online via Net Banking, Card, or UPI. Payment is mandatory to book a slot.","where":"Integrated SBI ePay Gateway","estimatedTime":"5 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":5,"title":"Schedule Appointment at Nearest PSK or POPSK","description":"Select your nearest Passport Seva Kendra (PSK) or Post Office Passport Seva Kendra (POPSK) and choose an available date and time slot. Print or download the Application Receipt showing your ARN and appointment batch time.","where":"Online Slot Booking System","estimatedTime":"5 minutes","calloutType":"important","calloutTitle":"SMS on Mobile Is Valid","calloutText":"Carrying an SMS appointment confirmation on your mobile phone with ARN is officially accepted at the PSK entrance gate in lieu of a paper printout.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":6,"title":"Visit the PSK with Original Documents","description":"Arrive 15 minutes before your appointment time. You will visit Counter A for biometrics, Counter B for document verification, and Counter C for approval.","where":"Designated Passport Seva Kendra (Physical Visit)","estimatedTime":"45-90 minutes","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":7,"title":"Undergo Local Police Verification","description":"If current address has changed, local police station conducts in-person physical address verification. The police officer visits your residence to check original address proof and verify your two local references.","where":"Applicant Residence / Local Police Station","estimatedTime":"3-7 working days","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"stepNumber":8,"title":"Receive Renewed Passport via Speed Post","description":"Once police verification report (PVR) is cleared, your passport is printed at the India Security Press and dispatched via India Post Speed Post. You will receive an SMS with the Speed Post tracking consignment number.","where":"Delivered to Current Residential Address","estimatedTime":"2-4 working days after printing","calloutType":"success","calloutTitle":"Old Passport Retention","calloutText":"Your old passport will be physically cancelled by the PSK officer (corners clipped) and handed back to you at Counter C. Any valid unexpired visas inside remain legally valid.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"documentRequirements":[{"name":"Recent Passport-Sized Photograph (For POPSK / Minors)","description":"Required when visiting a Post Office Passport Seva Kendra (POPSK) or uploading photos for minor applicants. Must strictly follow International Civil Aviation Organization (ICAO) biometric photo standards.","requirementType":"optional","copiesHint":"2 identical physical color prints","specs":{"dimensions":"35mm × 45mm (80% face coverage)","backgroundColor":"Plain white background without shadows","maxFileSizeBytes":204800,"maxFileSizeLabel":"20 KB to 200 KB","acceptedFormats":["JPEG","JPG"],"diagramType":"photo","guidanceUrl":"https://www.passportindia.gov.in","instructions":["Face should take up 70% to 80% of the vertical frame","Frontal pose with eyes open and neutral expression (no teeth showing)","Both ears must be clearly visible without hair covering them","Spectacles with thick frames or tinted glasses are strictly disallowed"]},"appliesWhen":{"isMinor":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Original Old Passport","description":"Existing physical passport book in original condition. The passport will be cancelled and returned to the applicant.","requirementType":"required","copiesHint":"Original required for physical cancellation","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Self-Attested Photocopy of Old Passport","description":"Clear photocopies of the first two pages (bio-data), last two pages (address), ECR/Non-ECR page, and any observation page.","requirementType":"required","copiesHint":"1 self-attested set","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Proof of Current Address","description":"Required if current residential address differs from the address printed on the old passport. Accepted proofs: Aadhaar Card, Electricity Bill (not older than 3 months), Water Bill, Bank Passbook with photo, or registered rent agreement.","requirementType":"conditional","copiesHint":"Original + 1 self-attested photocopy","appliesWhen":{"addressChanged":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Proof of Non-ECR Category (10th Marksheet or Degree Certificate)","description":"Educational certificate showing completion of 10th standard (Matriculation) or higher qualification to claim Emigration Check Not Required status.","requirementType":"conditional","copiesHint":"Original + 1 self-attested photocopy","appliesWhen":{"nonEcrEligible":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Marriage Certificate / Spouse Proof","description":"Required only if adding spouse name for the first time or requesting surname change after marriage.","requirementType":"conditional","copiesHint":"Original + 1 self-attested photocopy","appliesWhen":{"addSpouse":true},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0},{"name":"Annexure E / Tatkaal Verification Proof","description":"Standard self-declaration in format Annexure E required specifically for expedited Tatkaal passport processing.","requirementType":"conditional","copiesHint":"Original signed printout","appliesWhen":{"scheme":"tatkaal"},"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in","displayOrder":0}],"fees":[{"label":"Normal Re-issue Fee (36 Pages Booklet, 10-Year Validity)","amount":1500,"currency":"INR","isOptional":false,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Jumbo Re-issue Fee (60 Pages Booklet, 10-Year Validity)","amount":2000,"currency":"INR","isOptional":false,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Tatkaal Scheme Additional Surcharge (Expedited 1-3 Day Processing)","amount":2000,"currency":"INR","isOptional":true,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Minor Passport Re-issue Fee (Below 18 Years, 5-Year Validity)","amount":1000,"currency":"INR","isOptional":true,"paymentMode":"online","rulesReference":"Passports Rules, 1980 (Schedule IV)","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"feeCalculator":{"title":"Passport Re-issue Fee Calculator","description":"Select application urgency (Normal vs Tatkaal), booklet pages (36 vs 60), and applicant age to see your live statutory total.","baseFee":1500,"baseFeeLabel":"Base Statutory Fee (36 Pages Booklet, Adult)","options":[{"id":"scheme","label":"Processing Scheme","type":"scheme","choices":[{"id":"normal","label":"Normal Scheme (10–15 business days)","amount":0,"description":"Standard processing at Passport Seva Kendra"},{"id":"tatkal","label":"Tatkaal Scheme (Expedited 1–3 business days)","amount":2000,"description":"Urgent priority processing under Passports Act"}],"defaultChoiceId":"normal"},{"id":"pages","label":"Booklet Size","type":"pages","choices":[{"id":"pages36","label":"36 Pages (Standard Booklet)","amount":0,"description":"Recommended for standard travellers (10-year validity)"},{"id":"pages60","label":"60 Pages (Jumbo Booklet)","amount":500,"description":"Frequent flyer booklet (+₹500 gazette fee)"}],"defaultChoiceId":"pages36"},{"id":"applicant","label":"Applicant Category","type":"applicant","choices":[{"id":"adult","label":"Adult (18 years and above)","amount":0,"description":"Standard 10-year validity booklet"},{"id":"minor","label":"Minor (Below 18 years)","amount":-500,"description":"5-year validity or until age 18 (₹1,000 base fee)"}],"defaultChoiceId":"adult"},{"id":"delivery","label":"Dispatch & Notifications","type":"delivery","choices":[{"id":"standard_post","label":"Speed Post Delivery","amount":0,"description":"Included free by India Post & Ministry"},{"id":"sms_alert","label":"Speed Post + Premium SMS Tracking","amount":50,"description":"Optional 9 SMS dispatch updates (+₹50)"}],"defaultChoiceId":"standard_post"}],"officialSourceUrl":"https://passportindia.gov.in/AppOnlineProject/fee/feeSchedule","officialSourceLabel":"Ministry of External Affairs Fee Schedule","rulesReference":"Passports Rules 1980 Schedule IV"},"beforeYouGo":{"title":"Before You Leave for Passport Seva Kendra","subtitle":"5 final physical checks before heading out for your PSK slot","items":[{"id":"originals","title":"Original Old Passport & Aadhaar","description":"Carry physical original expired/expiring passport and original Aadhaar card for Biometric Counter A verification.","icon":"FolderCheck"},{"id":"photocopies","title":"2 Self-Attested Photocopy Sets","description":"First 2 and last 2 pages of passport + address proof, signed across blank margin in dark blue or black ink.","icon":"Copy"},{"id":"photos","title":"Photographs (Minors Only)","description":"Minors below 4 years require 2 physical passport photos (35x45mm white background); adults are photographed live at counter.","icon":"Camera"},{"id":"payment","title":"Fee Receipt / Active UPI","description":"Online payment receipt (already paid on portal) + carry UPI on phone in case SMS alert service or Tatkal upgrade is needed.","icon":"CreditCard"},{"id":"printout","title":"Application Receipt & Appointment SMS","description":"Printed ARN appointment receipt with bar code + appointment SMS on phone required for CISF security entry at gate.","icon":"FileText"}]},"officialLinks":[{"label":"Passport Seva Official Portal","url":"https://www.passportindia.gov.in","isPrimary":true,"department":"Consular, Passport and Visa (CPV) Division, Ministry of External Affairs","portalName":"Passport Seva Project","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"label":"Passport Fee Calculator (Official)","url":"https://www.passportindia.gov.in/AppOnlineProject/fee/feeInput","isPrimary":false,"department":"Ministry of External Affairs","portalName":"Fee Calculator","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"faqItems":[{"question":"How early before expiry can I apply for passport renewal in India?","answer":"You can apply up to 1 year before your passport expires. We recommend applying 6 to 9 months before expiry because many countries require 6 months validity.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"What happens to valid visas inside my old cancelled passport?","answer":"Your valid visas remain completely valid! The passport officer will only cancel the passport booklet itself by punching holes in the corners, leaving intact any pages containing active visas. When travelling abroad, simply carry both your new passport and the old cancelled passport containing the valid visa.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"Is police verification mandatory for every passport renewal?","answer":"Not always. If you apply within 3 years of expiry with no address change, police verification is usually waived or done post-issuance. If your address changed, pre-verification is required.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"Can I renew my passport under Tatkaal scheme?","answer":"Yes! Tatkaal renewal is available for urgent travel needs with an additional fee of ₹2,000. Tatkaal passports are dispatched within 1 to 3 working days from the date of application at the PSK. However, Tatkaal is not permitted if the passport has been expired for more than 3 years, lost, damaged, or if major name changes are requested.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"What if my passport has already expired for more than 3 years?","answer":"If your passport expired more than 3 years ago, renewal is still permitted but requires mandatory pre-issuance police verification. You will also be asked to provide an explanation letter stating the reason for late renewal.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"How do I add my spouse's name upon renewal?","answer":"In the online application form, select 'Add/Change Spouse Name' and enter your spouse's name. You must carry your Marriage Certificate or an unexpired passport of your spouse showing your name as spouse.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"Do I need to carry passport-size photos to the PSK?","answer":"For adults and children above 4 years of age, physical photos are NOT required. Your digital photograph and biometric fingerprints are captured live at Counter A inside the PSK. Only for infants and children under 4 years of age, parents must carry one recent passport-size color photograph with a plain white background.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"question":"How can I track the delivery status of my new passport?","answer":"You can track your application online on passportindia.gov.in using your 15-digit File Number / ARN. Once dispatched, an India Post Speed Post tracking number (Consignment Number) will be sent via SMS and displayed on the status page.","displayOrder":0,"status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"rejectionReasons":[{"title":"Address Mismatch Between Document Proof and Application","description":"Entering an address in the form that does not match your proof document will cause verification rejection. Always use an exact matching address document.","solution":"Ensure the current address typed into the form matches character-by-character with the utility bill or Aadhaar card submitted.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Unclear or Missing Pages in Old Passport Photocopy","description":"Failing to photocopy both the first two pages and the last two pages, or submitting illegible blurred copies.","solution":"Make clear, legible photocopies of pages 1, 2, 35, and 36, and self-attest each sheet with your signature.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Failed Police Verification Due to Absence from Residence","description":"When the local beat police officer visits your residence and neighbours report that you do not reside there or you cannot be contacted.","solution":"Provide active mobile numbers and ensure your two neighbourhood references are aware and available to verify your physical residence.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Applying Under Tatkaal Without Meeting Eligibility Criteria","description":"Tatkaal applications where the applicant has had major name changes, or whose previous passport was damaged or lost.","solution":"Check the official Tatkaal eligibility checklist on Passport Seva before choosing the Tatkaal scheme; otherwise apply under Normal.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Undisclosed Criminal Proceedings or Pending Court Cases","description":"Suppressing information regarding pending FIRs or criminal court summons violates Section 12 of the Passports Act 1967.","solution":"Always disclose pending matters and obtain an explicit No Objection Certificate (NOC) or court order permitting passport re-issue.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"},{"title":"Failure to Attend Rescheduled Appointments within 1 Year","description":"Missing scheduled appointment dates without attending a PSK within the 1-year application fee validity window leads to fee forfeiture.","solution":"Reschedule your appointment online if unable to attend. You are permitted up to 3 appointment reschedules within 12 months from payment date.","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z","sourceUrl":"https://www.passportindia.gov.in"}],"sourceRefs":[{"title":"The Passports Act, 1967","actOrRuleNumber":"Act No. 15 of 1967","issuingAuthority":"Parliament of India","url":"https://www.passportindia.gov.in","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z"},{"title":"The Passports Rules, 1980","actOrRuleNumber":"GSR 286(E) Schedule IV (Fees)","issuingAuthority":"Ministry of External Affairs, Government of India","url":"https://www.passportindia.gov.in","status":"PUBLISHED","lastVerifiedAt":"2026-11-14T00:00:00.000Z"}],"taskSlug":"passport-renewal","taskName":"Passport Renewal (Re-issue)","categorySlug":"identity","categoryName":"Identity Documents","isStateOverride":false,"stateCode":"GA","stateName":"Goa","stateSlug":"goa"},"relatedTasks":[],"popularTasks":[{"slug":"driving-licence-learner","name":"Learner's Licence Application","description":"How to apply for a learner driving licence (LLR) online or at an RTO in India.","categorySlug":"vehicles","categoryName":"Vehicles and Driving","difficulty":"easy","estimatedTime":"15-30 days","cost":"₹50 – ₹150","availableStates":["GJ"]},{"slug":"driving-licence-new","name":"Permanent Driving Licence Application","description":"How to get a permanent driving licence in India after holding a learner permit, with automated test track steps and Gujarat state rules.","categorySlug":"vehicles","categoryName":"Vehicles and Driving","difficulty":"medium","estimatedTime":"15-30 days after driving test","cost":"₹200 – ₹300","availableStates":["GJ"]},{"slug":"passport-renewal","name":"Passport Renewal (Re-issue)","description":"Complete guide to renewing or re-issuing an Indian passport online with verified fees, document checklist, and PSK appointment steps.","categorySlug":"identity","categoryName":"Identity Documents","difficulty":"medium","estimatedTime":"7-14 working days (Normal) / 1-3 days (Tatkaal)","cost":"₹1,500 – ₹2,000","availableStates":[]},{"slug":"pan-card-new","name":"New PAN Card (Form 49A)","description":"Apply for a new Permanent Account Number online or via physical application.","categorySlug":"money-and-tax","categoryName":"Money and Tax","difficulty":"easy","estimatedTime":"10–15 days","cost":"₹107","availableStates":[]}],"state":{"name":"Goa","nativeName":"गोंय","slug":"goa","code":"GA","primaryLanguages":["kok","en","mr"],"portalName":"Goa Online","portalUrl":""},"isStatePage":true}],["$L16","$L17","$L18","$L19","$L1a"],"$L1b"]}],"p":"$@1c","v":null,"s":"$8"}}]]

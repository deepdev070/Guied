{
  "expo": {
    "name": "India Paperwork Guide",
    "slug": "india-paperwork-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "indiapaperwork",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gov.paperworkguide.mobile",
      "userInterfaceStyle": "light",
      "associatedDomains": ["applinks:indiapaperwork.in", "applinks:www.indiapaperwork.in"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "in.gov.paperworkguide.mobile",
      "userInterfaceStyle": "light",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "indiapaperwork.in",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.indiapaperwork.in",
              "pathPrefix": "/"
            },
            {
              "scheme": "civicguide"
            },
            {
              "scheme": "indiapaperwork"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

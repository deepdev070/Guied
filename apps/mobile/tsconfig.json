{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-native"
  },
  "include": ["app/**/*", "**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "extends": "expo/tsconfig.base"
}

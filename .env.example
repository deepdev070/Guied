# ==============================================================================
# India Paperwork Guide — Environment Configuration Example
# Copy this file to .env.local for local development: cp .env.example .env.local
# ==============================================================================

# Database
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/india_paperwork_guide?schema=public"

# Public Site Configuration
# Canonical base URL for SEO canonical links, sitemaps, and OpenGraph images
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Monetization & Advertisements
# Enable or disable ad rendering across layouts ("true" or "false")
NEXT_PUBLIC_ADS_ENABLED="false"
# Google AdSense Publisher / Client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=""

# Analytics & Privacy
# Plausible Analytics custom domain (recommended for cookieless, DPDP-compliant tracking)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="indiapaperworkguide.in"
# Google Analytics Measurement ID (GA4) or privacy-focused analytics ID
NEXT_PUBLIC_ANALYTICS_ID=""

# Google Search Console Verification
# Value of the google-site-verification token or HTML meta tag content
NEXT_PUBLIC_GSC_VERIFICATION=""

# Administration & Authentication
# Primary administrator contact email
ADMIN_EMAIL="admin@indiapaperworkguide.in"
# Bcrypt or Argon2 password hash for admin dashboard / content verification
ADMIN_PASSWORD_HASH=""
# Secret token for on-demand ISR revalidation (/api/revalidate)
REVALIDATE_SECRET_TOKEN="paperwork-revalidate-secret-token-2026"

